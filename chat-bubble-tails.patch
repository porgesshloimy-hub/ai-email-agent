diff --git a/app/dashboard/components/ChatBubble.tsx b/app/dashboard/components/ChatBubble.tsx
new file mode 100644
index 0000000..0856324
--- /dev/null
+++ b/app/dashboard/components/ChatBubble.tsx
@@ -0,0 +1,51 @@
+import type { CSSProperties, ReactNode } from "react";
+import { ChatBubbleTail, TAIL_POSITION } from "./ChatBubbleTail";
+
+/**
+ * One chat bubble, with an optional tail. Must be rendered inside a
+ * `relative` wrapper — the tail is positioned against it.
+ *
+ * When there is a tail, the bubble corner it grows out of is squared
+ * off (inline style, so it reliably beats the shorthand radius class).
+ */
+export function ChatBubble({
+  isOwner,
+  hasTail,
+  pending = false,
+  className = "",
+  children,
+}: {
+  isOwner: boolean;
+  hasTail: boolean;
+  pending?: boolean;
+  className?: string;
+  children: ReactNode;
+}) {
+  let squaredCorner: CSSProperties | undefined;
+
+  if (hasTail) {
+    const atTop = TAIL_POSITION === "top";
+    squaredCorner = isOwner
+      ? atTop
+        ? { borderTopRightRadius: 0 }
+        : { borderBottomRightRadius: 0 }
+      : atTop
+        ? { borderTopLeftRadius: 0 }
+        : { borderBottomLeftRadius: 0 };
+  }
+
+  return (
+    <>
+      <div
+        style={squaredCorner}
+        className={`max-w-full whitespace-pre-wrap break-words rounded-panel px-3.5 py-2.5 text-sm leading-relaxed shadow-panel ${
+          isOwner ? "bg-blue-100 text-ink" : "bg-[#ECEEF1] text-ink"
+        } ${pending ? "opacity-60" : ""} ${className}`}
+      >
+        {children}
+      </div>
+
+      {hasTail && <ChatBubbleTail isOwner={isOwner} dimmed={pending} />}
+    </>
+  );
+}
diff --git a/app/dashboard/components/ChatBubbleTail.tsx b/app/dashboard/components/ChatBubbleTail.tsx
new file mode 100644
index 0000000..68ef13e
--- /dev/null
+++ b/app/dashboard/components/ChatBubbleTail.tsx
@@ -0,0 +1,47 @@
+/**
+ * The small protrusion on a chat bubble that marks "a new message
+ * starts here", as in WhatsApp and iMessage. Drawn only on the first
+ * bubble of a group (see chat-grouping.ts), never on the follow-ups.
+ *
+ * Positioned absolutely against the bubble's own `relative` wrapper,
+ * so it costs no layout space. The matching bubble corner is squared
+ * off by ChatBubble so the tail grows out of an edge instead of
+ * sitting beside a rounded corner.
+ */
+
+/**
+ * "top" is WhatsApp's look (tail at the upper outer corner, which suits
+ * a tail that marks the START of a group); "bottom" is iMessage's.
+ * Switching this one value flips both the tail and the squared corner.
+ */
+export const TAIL_POSITION: "top" | "bottom" = "top";
+
+// Bubble colors, duplicated here only because an SVG fill can't read a
+// background class. Keep in sync with ChatBubble.tsx.
+const OWNER_FILL = "fill-blue-100";
+const AGENT_FILL = "fill-[#ECEEF1]";
+
+export function ChatBubbleTail({ isOwner, dimmed = false }: { isOwner: boolean; dimmed?: boolean }) {
+  const atTop = TAIL_POSITION === "top";
+
+  const vertical = atTop ? "top-0" : "bottom-0 -scale-y-100";
+  // A half-pixel overlap with the bubble, so no hairline seam shows
+  // between them at fractional zoom levels.
+  const horizontal = isOwner
+    ? "left-[calc(100%-0.5px)]"
+    : "right-[calc(100%-0.5px)] -scale-x-100";
+
+  return (
+    <svg
+      aria-hidden="true"
+      viewBox="0 0 8 11"
+      width="8"
+      height="11"
+      className={`pointer-events-none absolute ${vertical} ${horizontal} ${
+        isOwner ? OWNER_FILL : AGENT_FILL
+      } ${dimmed ? "opacity-60" : ""}`}
+    >
+      <path d="M0 0H5C6.8 0 7.6 1.4 6.6 2.7L0 11Z" />
+    </svg>
+  );
+}
diff --git a/app/dashboard/components/chat-grouping.ts b/app/dashboard/components/chat-grouping.ts
new file mode 100644
index 0000000..fbd5b09
--- /dev/null
+++ b/app/dashboard/components/chat-grouping.ts
@@ -0,0 +1,54 @@
+/**
+ * How the chat widget decides which messages belong together.
+ *
+ * A "group" is a run of consecutive messages from the same sender that
+ * show the same time label — typically one reply the agent split into
+ * several bubbles, or a quick burst from the owner. The widget uses
+ * this one rule for two things, so they can never disagree:
+ *
+ *   - the timestamp: shown once, under the LAST message of a group
+ *   - the bubble tail: drawn on the FIRST message of a group, the way
+ *     WhatsApp marks "a new message starts here" (see ChatBubble.tsx)
+ *
+ * Kept free of React so the rule is plain and testable.
+ */
+
+export interface GroupableMessage {
+  role: string;
+  created_at: string;
+}
+
+export function formatTimeLabel(iso: string): string {
+  const date = new Date(iso);
+  const now = new Date();
+  const sameDay = date.toDateString() === now.toDateString();
+
+  if (sameDay) {
+    return date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
+  }
+
+  return date.toLocaleDateString("en-US", {
+    month: "short",
+    day: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+  });
+}
+
+/**
+ * True when `current` begins a new group — i.e. it was sent by someone
+ * different than `previous`, or at a different displayed time. With no
+ * previous message (the first one in the conversation) it always does.
+ *
+ * Because groups are symmetric, "does the message AFTER this one start
+ * a new group?" is also exactly "is this the last message of its
+ * group?", which is how the timestamp uses it.
+ */
+export function startsNewMessageGroup(
+  previous: GroupableMessage | undefined,
+  current: GroupableMessage
+): boolean {
+  if (!previous) return true;
+  if (previous.role !== current.role) return true;
+  return formatTimeLabel(previous.created_at) !== formatTimeLabel(current.created_at);
+}
